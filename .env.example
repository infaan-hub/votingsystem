# Copy to .env and adjust values.
# PostgreSQL (Neon) connection used by Prisma.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Separate database for `npm test`. The suite deletes every table between
# tests, so this must not be the same as DATABASE_URL. The name has to end
# in _test or the suite refuses to start.
TEST_DATABASE_URL="postgresql://user:password@host/voting_test?sslmode=require"

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Google OAuth client id exposed to the browser (Google Identity Services button).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
