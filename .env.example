# Copy to .env and fill in real values. .env is gitignored.
# Every variable the app reads is listed; optional ones have safe defaults.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# On Neon, use the pooler endpoint (hostname contains "-pooler"): the direct
# endpoint times out under serverless / connection-pooling clients.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Separate database used only by `npm test`. The suite deletes every table
# between tests, so this MUST NOT be the same database as DATABASE_URL. The
# database name has to end in "_test" or the suite refuses to start.
# Create it once with: npm run db:test-setup
TEST_DATABASE_URL="postgresql://user:password@host/voting_test?sslmode=require"

# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------
# Leave all three empty to disable Google sign-in; the API then returns 503
# on the Google auth routes and password login keeps working.

# OAuth client ID used server-side to verify ID tokens.
GOOGLE_OAUTH_CLIENT_ID=""

# Matching OAuth client secret, used server-side for the token exchange.
GOOGLE_OAUTH_CLIENT_SECRET=""

# Same client ID, exposed to the browser for the Google Identity Services
# button. Must match GOOGLE_OAUTH_CLIENT_ID when Google sign-in is enabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Tuning (optional — safe defaults are built in)
# ---------------------------------------------------------------------------
# Base URL the browser uses to reach the API. Leave as "/api" unless the API
# is hosted on a different origin.
NEXT_PUBLIC_API_BASE="/api"

# PBKDF2 iteration count for password hashing. Production default is 720000.
# Lower this only for local test runs; tests set it to 1000 automatically.
# Never lower it in production — it is the main cost of cracking a password.
PBKDF2_ITERATIONS="720000"
