generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections  Section[]
  users     User[]
  positions Position[]
  candidates Candidate[]
}

model Section {
  id           Int      @id @default(autoincrement())
  departmentId Int
  name         String
  code         String
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]
  positions  Position[]
  candidates Candidate[]

  @@unique([departmentId, code])
}

model User {
  id                Int       @id @default(autoincrement())
  password          String    @default("")
  lastLogin         DateTime?
  isSuperuser       Boolean   @default(false)
  username          String    @unique
  firstName         String    @default("")
  lastName          String    @default("")
  email             String    @default("")
  isStaff           Boolean   @default(false)
  isActive          Boolean   @default(true)
  dateJoined        DateTime  @default(now())
  role              String    @default("student")
  departmentId      Int?
  sectionId         Int?
  registrationNumber String   @default("")
  staffId           String    @default("")
  phoneNumber       String    @default("")
  googleId          String?   @unique
  authProvider      String    @default("local")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  votes      Vote[]
  candidateProfiles Candidate[]
  token      Token?

  @@index([role])
}

model Token {
  key       String   @id
  created   DateTime @default(now())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Election {
  id                       Int       @id @default(autoincrement())
  title                    String
  description              String    @default("")
  image                    String?
  imageBytes               Bytes?
  imageContentType         String    @default("")
  imageFilename            String    @default("")
  campaignStartAt          DateTime
  campaignEndAt            DateTime
  votingStartAt            DateTime
  votingEndAt              DateTime
  allowLiveResults         Boolean   @default(true)
  announceWinnersAutomatically Boolean @default(true)
  isPublished              Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  positions    Position[]
  candidates   Candidate[]
  votes        Vote[]
  announcements Announcement[]
}

model Position {
  id           Int      @id @default(autoincrement())
  electionId   Int
  name         String
  description  String   @default("")
  departmentId Int?
  sectionId    Int?
  voterGroup   String   @default("all")
  maxWinners   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  election   Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  candidates Candidate[]
  votes      Vote[]

  @@unique([electionId, name, departmentId, sectionId])
  @@index([electionId])
}

model Candidate {
  id                      Int      @id @default(autoincrement())
  electionId              Int
  positionId              Int
  userId                  Int
  departmentId            Int?
  sectionId               Int?
  slogan                  String   @default("")
  manifesto               String   @default("")
  campaignVideo           String?
  campaignVideoUrl        String   @default("")
          campaignVideoBytes      Bytes?
  campaignVideoContentType String   @default("")
  campaignVideoFilename   String   @default("")
  photo                   String?
  photoBytes              Bytes?
  photoContentType        String   @default("")
  photoFilename           String   @default("")
  approved                Boolean  @default(false)
  featuredOrder           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  election   Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  votes Vote[]

  @@unique([electionId, positionId, userId])
  @@index([positionId])
}

model Vote {
  id          Int      @id @default(autoincrement())
  voterId     Int
  candidateId Int
  electionId  Int
  positionId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  voter     User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  election  Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([voterId, electionId, positionId])
  @@index([electionId])
  @@index([candidateId])
}

model Announcement {
  id               Int       @id @default(autoincrement())
  electionId       Int?
  title            String
  message          String
  announcementType String    @default("notice")
  publishAt        DateTime?
  isPinned         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  election Election? @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
}
