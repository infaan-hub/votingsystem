generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Legacy academic structures. RETAINED as OPTIONAL, organization-specific
// metadata for backward compatibility. A general-purpose election works with
// none of these populated.
// ---------------------------------------------------------------------------

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  sections   Section[]
  users      User[]
  positions  Position[]
  candidates Candidate[]
}

model Section {
  id           Int      @id @default(autoincrement())
  departmentId Int
  name         String
  code         String
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]
  positions  Position[]
  candidates Candidate[]

  @@unique([departmentId, code])
}

// ---------------------------------------------------------------------------
// General-purpose platform domain
// ---------------------------------------------------------------------------

model ElectionCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  icon        String   @default("")
  isActive    Boolean  @default(true)
  /// Seeded platform defaults cannot be deleted while referenced.
  isSystem    Boolean  @default(false)
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User?      @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  elections Election[]
  electionRequests ElectionRequest[]

  @@index([isActive])
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  /// Free-form: company, association, club, community, union, board, custom...
  orgType     String   @default("association")
  isActive    Boolean  @default(true)
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User?         @relation("OrgCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  departments Department[]
  elections   Election[]
  officerAssignments OfficerAssignment[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id                 Int       @id @default(autoincrement())
  password           String    @default("")
  lastLogin          DateTime?
  isSuperuser        Boolean   @default(false)
  username           String    @unique
  firstName          String    @default("")
  lastName           String    @default("")
  email              String    @default("")
  isStaff            Boolean   @default(false)
  isActive           Boolean   @default(true)
  dateJoined         DateTime  @default(now())
  /// Platform role: voter / officer / admin.
  role               String    @default("voter")
  departmentId       Int?
  sectionId          Int?
  registrationNumber String    @default("")
  staffId            String    @default("")
  phoneNumber        String    @default("")
  googleId           String?   @unique
  authProvider       String   @default("local")
  /// Profile picture stored as bytes, like Candidate.photo and Election.image.
  photo              String?
  photoBytes         Bytes?
  photoContentType   String    @default("")
  photoFilename      String    @default("")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  votes              Vote[]
  candidateProfiles  Candidate[]
  ratings            CandidateRating[]
  opinions           Opinion[]
  opinionVotes       OpinionVote[]
  token              Token?
  categoriesCreated  ElectionCategory[] @relation("CategoryCreator")
  organizationsCreated Organization[]    @relation("OrgCreator")
  electionsCreated   Election[]
  electionRequests   ElectionRequest[]   @relation("Requester")
  contactMessages    ContactMessage[]
  auditLogs          AuditLog[]         @relation("AuditActor")
  officerAssignments OfficerAssignment[] @relation("OfficerAssignee")
  campaignsOwned     Campaign[]         @relation("CampaignOwner")
  notifications      Notification[]     @relation("UserNotifications")
  pushSubscriptions  PushSubscription[] @relation("UserPushSubscriptions")

  @@index([role])
}

/// In-app notification record for one recipient. The API is the source of
/// truth for read state; push delivery attempts live in PushDelivery.
model Notification {
  id             Int       @id @default(autoincrement())
  recipientId    Int
  recipient      User      @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  title          String
  body           String    @default("")
  category       String    @default("general")
  /// Safe same-origin path the notification opens, e.g. /elections/foo.
  targetUrl      String    @default("")
  tag            String    @default("")
  data           Json?
  /// Stable key per logical event + recipient; retries never duplicate rows.
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  expiresAt      DateTime?

  deliveries PushDelivery[]

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
}

/// One browser/device Push API subscription for a user.
model PushSubscription {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  disabledAt    DateTime?

  deliveries PushDelivery[]

  @@index([userId])
}

/// Durable outbox row: one per (notification, subscription). Statuses:
/// pending | queued | accepted | failed | expired.
model PushDelivery {
  id             Int                @id @default(autoincrement())
  notificationId Int
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  /// Nullable: an expired/unsubscribed device is deleted, but the delivery
  /// audit row is kept (SET NULL) so the terminal state stays inspectable.
  subscriptionId Int?
  subscription   PushSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status         String             @default("pending")
  attemptCount   Int                @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  errorCode      String             @default("")
  acceptedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@index([status, nextAttemptAt])
  @@index([notificationId])
}

model Token {
  key       String   @id
  created   DateTime @default(now())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Elections
// ---------------------------------------------------------------------------

model Election {
  id    Int    @id @default(autoincrement())
  /// Public, stable identifier used in routes (`/vote/[slug]`).
  slug  String @unique @default("")
  title String
  description   String @default("")
  instructions  String @default("")
  image         String?
  imageBytes    Bytes?
  imageContentType String @default("")
  imageFilename    String @default("")

  categoryId       Int?
  organizationId   Int?
  /// DRAFT / PUBLISHED / NOMINATIONS / READY / OPEN / CLOSED / RESULTS_PUBLISHED / ARCHIVED
  status           String   @default("DRAFT")
  /// registered / org_members / voter_list / invite_only / open / legacy_academic
  eligibilityPolicy String  @default("registered")
  /// hidden / admin_only / officers / live / published / public
  resultVisibility  String  @default("live")
  secretBallot      Boolean @default(false)
  /// IANA timezone; scheduling evaluated against this + server time.
  timezone          String  @default("UTC")
  /// Deliberate, documented exception. Default: administrators cannot vote.
  allowAdminsToVote Boolean @default(false)

  campaignStartAt DateTime
  campaignEndAt   DateTime
  votingStartAt   DateTime
  votingEndAt     DateTime
  registrationStartAt DateTime?
  registrationEndAt   DateTime?
  nominationStartAt DateTime?
  nominationEndAt   DateTime?

  // ---- Officer-configured election rules (Part 5, steps E–F) -------------
  /// Free-text "who may vote" description shown to voters. Never used as a
  /// security control on its own — `eligibilityPolicy`/`capacityMode` are.
  rulesText     String @default("")
  /// account / email / phone / membership / employee / student_id / custom
  voterIdMethod String @default("account")
  /// Human label for a custom identifier, e.g. "Library card number".
  voterIdLabel  String @default("")
  /// `restricted` = finite eligible list or maxVoters; `open` = public election
  /// with no pre-declared participant cap (eligibility still enforced).
  capacityMode  String @default("restricted")
  /// Null means "no declared cap" and only applies when capacityMode = open.
  maxVoters     Int?
  /// public / unlisted / private. Private elections require a valid share
  /// token on the public detail route.
  visibility    String @default("public")
  /// Stable, non-sequential share token for protected invitation links.
  shareToken       String?   @unique
  shareTokenExpiry DateTime?

  resultFinalizedAt  DateTime?
  resultPublishedAt  DateTime?
  /// Set when an administrator approves the originating ElectionRequest.
  approvedRequestId  Int?

  allowLiveResults            Boolean   @default(true)
  announceWinnersAutomatically Boolean  @default(true)
  isPublished                 Boolean   @default(true)
  archivedAt                  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       ElectionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creator        User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy      Int?

  positions      Position[]
  candidates     Candidate[]
  votes          Vote[]
  announcements  Announcement[]
  campaigns      Campaign[]
  electionVoters ElectionVoter[]
  officerAssignments OfficerAssignment[]

  @@index([categoryId])
  @@index([organizationId])
  @@index([status])
  /// Hot path: the landing page lists published elections by opening time.
  @@index([isPublished, votingStartAt])
}

model Position {
  id           Int    @id @default(autoincrement())
  electionId   Int
  name         String
  description  String   @default("")
  /// candidate / yes_no / multiple_choice
  ballotType   String   @default("candidate")
  /// Max selections a voter may make for this question.
  maxSelections Int     @default(1)
  allowWriteIn Boolean  @default(false)
  /// Display + tally order within the election.
  order        Int      @default(0)
  departmentId Int?
  sectionId    Int?
  voterGroup   String   @default("all")
  maxWinners   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  election   Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  candidates     Candidate[]
  votes          Vote[]
  ballotOptions  BallotOption[]
  ratingCategories RatingCategory[]

  @@unique([electionId, name, departmentId, sectionId])
  @@index([electionId])
}

/// Non-candidate ballot choices: Yes/No referendums, multiple-choice polls.
model BallotOption {
  id          Int     @id @default(autoincrement())
  positionId  Int
  label       String
  description String  @default("")
  order       Int     @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  votes    Vote[]

  @@unique([positionId, label])
  @@index([positionId])
}

model Candidate {
  id                      Int      @id @default(autoincrement())
  electionId              Int
  positionId              Int
  userId                  Int
  /// Optional ballot group (party/slate/ticket). Null for non-partisan ballots.
  partyId                 Int?
  departmentId            Int?
  sectionId               Int?
  slogan                  String   @default("")
  manifesto               String   @default("")
  campaignVideo           String?
  campaignVideoUrl        String   @default("")
  campaignVideoBytes      Bytes?
  campaignVideoContentType String  @default("")
  campaignVideoFilename   String   @default("")
  photo                   String?
  photoBytes              Bytes?
  photoContentType        String   @default("")
  photoFilename           String   @default("")
  approved                Boolean  @default(false)
  featuredOrder           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  election   Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position   Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  party      Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  votes   Vote[]
  ratings CandidateRating[]
  opinions Opinion[]
  campaigns Campaign[]
  images  CandidateImage[]

  @@unique([electionId, positionId, userId])
  @@index([positionId])
  @@index([partyId])
}

/// Optional extra candidate photos beyond the primary `Candidate.photo`
/// (the officer builder allows up to two additional images).
model CandidateImage {
  id          Int     @id @default(autoincrement())
  candidateId Int
  /// 1 = first extra image, 2 = second extra image.
  slot        Int     @default(1)
  imageBytes  Bytes
  imageContentType String @default("image/jpeg")
  imageFilename    String @default("")
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, slot])
  @@index([candidateId])
}

/// Ballot group. Generic by default ("Party"); the tenant renames it via
/// `config/tenant.ts` so the same model serves parties, slates, tickets, or
/// non-partisan ballots (partyId stays null).
model Party {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  /** Short code rendered on candidate badges, e.g. "LAB", "GRN". */
  code      String   @default("")
  emblemUrl String   @default("")
  /// Brand colour used for badges and results bars.
  color     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]

  @@index([isActive])
}

/// A dimension candidates are scored on, scoped to a question so a presidential
/// race can rate "Debate" and "Policy" while a referendum rates nothing.
model RatingCategory {
  id         Int      @id @default(autoincrement())
  positionId Int
  name       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  position Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  ratings  CandidateRating[]

  @@unique([positionId, name])
  @@index([positionId])
}

/// One voter's score for one candidate on one category (1–5).
model CandidateRating {
  id          Int      @id @default(autoincrement())
  candidateId Int
  voterId     Int
  categoryId  Int
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User           @relation(fields: [voterId], references: [id], onDelete: Cascade)
  category  RatingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([candidateId, voterId, categoryId])
  @@index([candidateId])
  @@index([categoryId])
}

/// A public comment a voter leaves about a candidate, with community votes.
model Opinion {
  id          Int      @id @default(autoincrement())
  candidateId Int
  voterId     Int
  body        String
  up          Int      @default(0)
  down        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User          @relation(fields: [voterId], references: [id], onDelete: Cascade)
  reactions OpinionVote[]

  @@index([candidateId])
}

/// One voter's reaction to an opinion; the pair is unique so reaction counts
/// cannot be inflated by repeated taps.
model OpinionVote {
  id        Int      @id @default(autoincrement())
  opinionId Int
  voterId   Int
  /// "up" or "down".
  value     String
  createdAt DateTime @default(now())

  opinion Opinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  voter   User    @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([opinionId, voterId])
  @@index([opinionId])
}

// ---------------------------------------------------------------------------
// Voting
//
// A Vote is one selection by one voter for one question (position). Uniqueness
// (voterId, electionId, positionId) is the authoritative duplicate-vote gate,
// enforced by the database and relied on inside a transaction so concurrent
// submissions cannot both succeed. candidateId is nullable so a vote may target
// a BallotOption (yes/no, multiple-choice) instead of a candidate.
//
// Secret-ballot separation (unlinking voter identity from selections) and
// multi-select ballots are documented future enhancements; the current model
// intentionally preserves the working single-select candidate flow.
// ---------------------------------------------------------------------------

model Vote {
  id         Int      @id @default(autoincrement())
  voterId    Int
  electionId Int
  positionId Int
  /// Selection target: exactly one of candidateId / ballotOptionId / writeInText.
  candidateId    Int?
  ballotOptionId Int?
  writeInText    String   @default("")
  /// Verification code returned to the voter. Not derived from any ballot
  /// content, so it cannot be used to infer a choice.
  receiptCode    String   @default("")
  /// Client-supplied retry key. Nullable so the unique constraint only applies
  /// to keys that were actually sent; Postgres treats NULLs as distinct, so
  /// ordinary votes never collide with each other.
  idempotencyKey String?
  createdAt  DateTime @default(now())

  voter        User         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  election     Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position     Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate    Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  ballotOption BallotOption? @relation(fields: [ballotOptionId], references: [id], onDelete: Cascade)

  @@unique([voterId, electionId, positionId])
  @@unique([idempotencyKey])
  @@index([electionId])
  @@index([positionId])
  @@index([candidateId])
  @@index([ballotOptionId])
  @@index([voterId, electionId])
}

model Announcement {
  id               Int       @id @default(autoincrement())
  electionId       Int?
  title            String
  message          String
  announcementType String    @default("notice")
  publishAt        DateTime?
  isPinned         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  election Election? @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
}

// ---------------------------------------------------------------------------
// Election requests (normal user → administrator review)
// ---------------------------------------------------------------------------

model ElectionRequest {
  id          Int      @id @default(autoincrement())
  requesterId Int
  title       String
  /// Free-form category name when the requester picks "Other".
  categoryName String  @default("")
  categoryId  Int?
  organization String  @default("")
  description String   @default("")
  purpose     String   @default("")
  startAt     DateTime
  endAt       DateTime
  /// Expected number of voters; 0 means "not specified".
  expectedVoters Int   @default(0)
  /// public / restricted / internal — the requester's proposed election type.
  electionType  String  @default("public")
  /// Proposed voter identification method (account, student_id, membership...).
  voterIdMethod String  @default("account")
  /// Newline/comma separated proposed positions.
  positionsText String  @default("")
  reason      String   @default("")
  contactInfo String   @default("")

  /// PENDING / UNDER_REVIEW / APPROVED / REJECTED / CHANGES_REQUESTED / CANCELLED
  status      String   @default("PENDING")
  decisionNote String  @default("")
  decidedBy   Int?
  decidedAt   DateTime?
  assignedOfficerId Int?
  /// Set when approval produced an election.
  electionId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User  @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  category  ElectionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requesterId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Officer assignment scope
// ---------------------------------------------------------------------------

/// `scope`: "all" | "election" | "organization".
/// `electionId` / `organizationId` hold the target for the narrower scopes.
model OfficerAssignment {
  id             Int      @id @default(autoincrement())
  officerId      Int
  scope          String   @default("all")
  electionId     Int?
  organizationId Int?
  assignedBy     Int?
  isActive       Boolean  @default(true)
  note           String   @default("")
  createdAt      DateTime @default(now())

  officer      User          @relation("OfficerAssignee", fields: [officerId], references: [id], onDelete: Cascade)
  election     Election?     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([officerId])
  @@index([electionId])
}

// ---------------------------------------------------------------------------
// Voter eligibility (structured, server-enforced)
// ---------------------------------------------------------------------------

/// Pre-declared eligible voter for a restricted election.
/// `uniqueKey` is either `u:<userId>` or `h:<sha256(identifier)>` so the
/// unique constraint works whether the row is account-bound or ID-bound.
/// Identifiers are only ever stored as salted hashes, never in clear text.
model ElectionVoter {
  id          Int      @id @default(autoincrement())
  electionId  Int
  uniqueKey   String
  userId      Int?
  /// Display label (e.g. department or masked identifier) — never the raw ID.
  label       String   @default("")
  createdAt   DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, uniqueKey])
  @@index([electionId])
}

// ---------------------------------------------------------------------------
// Candidate campaigns (created by election officers)
// ---------------------------------------------------------------------------

model Campaign {
  id          Int      @id @default(autoincrement())
  electionId  Int
  candidateId Int
  /// Officer who authored the campaign; used for scope enforcement.
  ownerId     Int?
  topic       String
  description String   @default("")
  /// Main campaign image, stored as bytes like the rest of the media.
  imageBytes        Bytes?
  imageContentType  String  @default("")
  imageFilename     String  @default("")
  /// Campaign video (max 30 seconds). Duration is inspected server-side.
  videoBytes        Bytes?
  videoContentType  String  @default("")
  videoFilename     String  @default("")
  videoDurationSeconds Int  @default(0)
  /// Legacy/external URL fallback when no bytes are stored.
  videoUrl          String   @default("")
  startAt     DateTime?
  endAt       DateTime?
  /// DRAFT / PENDING / PUBLISHED / HIDDEN / REJECTED
  status      String   @default("DRAFT")
  moderationNote String @default("")
  moderatedBy Int?
  moderatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  owner     User?     @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  images    CampaignImage[]

  @@index([electionId])
  @@index([candidateId])
  @@index([status])
}

/// Additional campaign images beyond the main one.
model CampaignImage {
  id         Int    @id @default(autoincrement())
  campaignId Int
  slot       Int    @default(1)
  imageBytes Bytes
  imageContentType String @default("image/jpeg")
  imageFilename    String @default("")
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, slot])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Contact + audit
// ---------------------------------------------------------------------------

model ContactMessage {
  id        Int      @id @default(autoincrement())
  userId    Int?
  name      String
  email     String
  subject   String
  message   String
  /// NEW / OPEN / RESOLVED
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

/// Append-only activity record. There is no update or delete API for this
/// table; rows are written by server code only.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  /// e.g. "officer.election.create", "admin.request.approve".
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  summary    String   @default("")
  /// JSON-encoded detail. Never contains passwords, tokens or ballot choices.
  detail     String   @default("{}")
  ipAddress  String   @default("")
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}